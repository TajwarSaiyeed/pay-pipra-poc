{
  "name": "PipraPay POC",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "postStartCommand": "pip install -r requirements.txt && python manage.py migrate",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Django App",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "orders/views.py"]
    }
  }
}
