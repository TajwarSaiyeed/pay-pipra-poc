{
  "name": "PipraPay POC",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "postStartCommand": "pip install -r requirements.txt",
  "forwardPorts": [
    { "name": "Django", "port": 8000, "onAutoForward": "openPreview" },
    { "name": "PipraPay", "port": 8080, "onAutoForward": "notify" },
    { "name": "PostgreSQL", "port": 5432 }
  ],
  "portsAttributes": {
    "8000": { "label": "Django App", "onAutoForward": "openPreview" },
    "8080": { "label": "PipraPay Admin" },
    "5432": { "label": "PostgreSQL" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "config.yaml"]
    }
  }
}
